{
  "name": "@falcondev-oss/workflow",
  "type": "module",
  "version": "0.19.1",
  "packageManager": "pnpm@12.16.1",
  "description": "Durable, type-safe queue workers on Redis with memoized steps, cron schedules, group ordering, OpenTelemetry tracing.",
  "license": "MIT",
  "repository": "github:falcondev-oss/workflow",
  "bugs": {
    "url": "https://github.com/falcondev-oss/workflow/issues"
  },
  "keywords": [
    "queue",
    "worker",
    "bullmq",
    "redis",
    "durable-execution",
    "tracing",
    "typescript"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "26",
    "pnpm": "12"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint --cache . && prettier --check --cache .",
    "lint:ci": "eslint --cache --cache-strategy content . && prettier --check --cache --cache-strategy content .",
    "lint:fix": "eslint --fix --cache . && prettier --write --cache .",
    "bench": "tsx bench/e2e.ts"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@opentelemetry/api": "^1.10.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.6.6",
    "croner": "^11.0.0",
    "exit-hook": "^5.1.0",
    "ioredis": "^6.0.0",
    "superjson": "^2.2.6",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@falcondev-oss/configs": "^6.0.6",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@testcontainers/redis": "^12.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "arktype": "^2.2.9",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "rolldown": "1.2.16",
    "tsdown": "0.23.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}
